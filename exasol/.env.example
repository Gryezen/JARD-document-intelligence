# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Exasol: read-write identity ---
# Used by ingestion, extraction, reasoning, action, human-review and audit
# code — everything except the chat agent's query execution.
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=
EXASOL_SCHEMA=DOC_INTEL

# --- Exasol: read-only identity ---
# Used ONLY by the chat agent to execute the SQL it generates (see
# docs/mcp-grants.sql for the GRANT SELECT statement that creates this
# user). Falls back to EXASOL_DSN if EXASOL_RO_DSN is not set.
EXASOL_RO_DSN=localhost:8563
EXASOL_RO_USER=
EXASOL_RO_PASSWORD=

# --- LLM (Gemini) ---
# One key covers extraction, reasoning, action drafting, relationship
# inference, and chat SQL generation. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.6-flash
CHAT_MODEL=gemini-3.6-flash

# --- Pipeline behavior ---
# Fields with confidence below this pause for human review (0.0-1.0).
CONFIDENCE_THRESHOLD=0.8

# Where uploaded source files are stored before/after processing.
UPLOAD_DIR=./data/uploads
