# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Exasol: read-write identity ---
# Used by ingestion, extraction, reasoning, action, human-review and audit
# code — everything except the chat agent's query execution.
EXASOL_DSN=localhost:8563
EXASOL_USER=sys
EXASOL_PASSWORD=
EXASOL_SCHEMA=DOC_INTEL

# --- Exasol: read-only identity ---
# Used ONLY by the chat agent to execute the SQL it generates (see
# docs/mcp-grants.sql for the GRANT SELECT statement that creates this
# user). Falls back to EXASOL_DSN if EXASOL_RO_DSN is not set.
EXASOL_RO_DSN=localhost:8563
EXASOL_RO_USER=
EXASOL_RO_PASSWORD=

# --- LLM ---
# Three independent slots. Each defaults to "ollama" (local, free, runs on
# your GPU, no quota). Flip any single slot to "gemini" if you specifically
# want that one path on a hosted model — GEMINI_API_KEY is only required
# if at least one slot uses it.
#
#   EXTRACTION_PROVIDER — pulls structured fields out of uploaded docs
#   REASONING_PROVIDER   — also used by action drafting + relationship inference
#   CHAT_PROVIDER         — generates the read-only SQL behind the chat agent
EXTRACTION_PROVIDER=ollama
REASONING_PROVIDER=ollama
CHAT_PROVIDER=ollama

# Ollama server this app talks to. Default assumes `ollama serve` running
# on the same machine. Pull the model first: ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
EXTRACTION_MODEL=qwen2.5:7b-instruct
REASONING_MODEL=qwen2.5:7b-instruct
CHAT_MODEL=qwen2.5:7b-instruct

# Only needed if EXTRACTION_PROVIDER / REASONING_PROVIDER / CHAT_PROVIDER
# is set to "gemini" for at least one slot. Get a free key at
# https://aistudio.google.com/apikey. When a slot uses gemini, its default
# model becomes gemini-3.6-flash unless overridden above.
GEMINI_API_KEY=

# --- Pipeline behavior ---
# Fields with confidence below this pause for human review (0.0-1.0).
CONFIDENCE_THRESHOLD=0.8

# Where uploaded source files are stored before/after processing.
UPLOAD_DIR=./data/uploads
